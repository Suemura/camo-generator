{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * HEAD:main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/pre-push-guard.sh\"",
            "timeout": 30
          }
        ],
        "matcher": "Bash|exec_command"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/format.sh\"",
            "timeout": 30
          }
        ],
        "matcher": "Write|Edit|apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/pr-created.sh\"",
            "timeout": 30
          }
        ],
        "matcher": "Bash|exec_command"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/session-start-worktrees.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/check-on-stop.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
