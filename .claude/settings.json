{
  "permissions": {
    "allow": [
      "Artifact",
      "Bash(pnpm test -u)",
      "Bash(pnpm test -u *)",
      "Bash(pnpm test -- -u*)",
      "Bash(pnpm vitest -u*)",
      "Bash(pnpm exec vitest -u*)",
      "Bash(npx vitest -u*)",
      "Bash(wrangler deploy *)",
      "Bash(pnpm exec wrangler deploy *)",
      "Bash(npx wrangler deploy *)",
      "Bash(pnpm deploy)",
      "Bash(pnpm deploy *)",
      "Bash(pnpm run deploy)",
      "Bash(pnpm run deploy *)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git merge-base:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm tokens:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(node tools/render.mjs:*)",
      "Bash(node tools/extract-palette.mjs:*)",
      "Bash(node tools/gen-src.mjs:*)",
      "Bash(node tools/gen-tokens.mjs:*)",
      "Bash(bash tools/check-private-refs.sh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(python3:*)",
      "Bash(curl -s:*)",
      "Bash(curl -sL:*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Read(.env*)",
      "Edit(.env*)",
      "Write(.env*)",
      "Read(.dev.vars*)",
      "Edit(.dev.vars*)",
      "Write(.dev.vars*)"
    ],
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * HEAD:main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-guard.sh\"",
            "timeout": 30,
            "statusMessage": "refs/private の混入を検査中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in */prototype/*|*/src/core/*) ;; *.ts|*.tsx|*.js|*.mjs|*.json) pnpm exec biome check --write \"$f\" 2>/dev/null || true;; esac; }",
            "timeout": 30,
            "statusMessage": "Biome でフォーマット中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-created.sh\"",
            "timeout": 30,
            "statusMessage": "PR 作成を検知..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-worktrees.sh\"",
            "timeout": 20,
            "statusMessage": "stale worktree を確認中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-on-stop.sh\"",
            "timeout": 300,
            "statusMessage": "check / typecheck / test を実行中..."
          }
        ]
      }
    ]
  }
}
