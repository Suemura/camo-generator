#!/bin/bash
# pre-push: refs/private/ (再配布不可のリファレンス画像) を含むコミットの push を拒否する。
# 有効化: `pnpm install` の prepare スクリプトが `git config core.hooksPath .githooks` を設定する
#         (手動なら同コマンドを実行)。判定本体は tools/check-private-refs.sh。
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" 行が push 対象ごとに渡される。
set -u
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue # ブランチ削除
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha" # 新規ブランチ: 到達可能な全履歴
  else
    range="$remote_sha..$local_sha"
  fi
  bash tools/check-private-refs.sh "$range" || status=1
done
if [ $status -ne 0 ]; then
  echo "push を中止しました (refs/private/ の混入)。" >&2
fi
exit $status
